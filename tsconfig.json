{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@shared/*": ["./supabase/functions/_shared/*"] }
  },
  "include": [
    "src",
    "supabase/functions/_shared",
    "supabase/functions/daily-digest/eligibility.ts",
    "vite.config.ts"
  ]
}
